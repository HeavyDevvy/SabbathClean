{
  "version": 2,
  "builds": [
    { "src": "api/**/*.ts", "use": "@vercel/node" },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist/public" }
    }
  ],
  "routes": [
    { "handle": "filesystem" },

    { "src": "^/api/admin/providers/([^/]+)/approve$", "dest": "/api/admin/providers/approve?providerId=$1" },
    { "src": "^/api/admin/providers/([^/]+)/decline$", "dest": "/api/admin/providers/decline?providerId=$1" },

    { "src": "^/api/(.*)$", "dest": "/api/$1" },
    { "src": "^(.*)$", "dest": "/index.html" }
  ]
}